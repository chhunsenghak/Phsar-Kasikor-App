# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="Phsar Kasikor App Backend"

# Security (Change this in production!)
# Generate using: openssl rand -hex 32
SECRET_KEY=yoursecretkeyhere_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=phsarkasikor
# For SQLite: sqlite:///./sql_app.db
# For PostgreSQL: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@db:5432/phsarkasikor

# Docker Container Config
PROJECT_APP_NAME=phsar_kasikor
POSTGRES_PORT=5432
API_PORT=8000

# Push notifications (Firebase Cloud Messaging) — download from
# Firebase console > Project Settings > Service Accounts > Generate new private key.
# Leave empty to disable push sends (notifications still save to the DB).
FIREBASE_SERVICE_ACCOUNT_PATH=

# Email (SMTP) — password reset + verification codes
# Gmail: use an App Password (Google Account > Security > 2-Step Verification >
# App passwords), not your regular account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Bakong KHQR payment gateway
# BAKONG_API_BASE_URL: sandbox is https://sit-api-bakong.nbc.gov.kh, production
# is https://api-bakong.nbc.gov.kh — confirm against whatever docs you have.
# BAKONG_BEARER_TOKEN: renewable token issued from the Bakong developer portal
# (this is NOT a static API key — it expires and must be refreshed periodically).
# BAKONG_MERCHANT_ACCOUNT_ID: your Bakong account ID used to generate KHQR strings
# (e.g. someone@aclb format), from the same portal.
BAKONG_API_BASE_URL=
BAKONG_BEARER_TOKEN=
BAKONG_MERCHANT_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=
